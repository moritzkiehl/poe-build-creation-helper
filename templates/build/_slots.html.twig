{% set filled = {} %}
{% for entry in document.inventorySlots %}
    {% set filled = filled|merge({(entry.inventory_id ~ '@' ~ (entry.slot_x|default(0))): entry}) %}
{% endfor %}

<section id="build-slots" class="full">
    <h2>Equipment</h2>
    <p>One unique per slot, by name. The format carries no rares and no numbers — this is its whole scope.</p>

    <form action="{{ path('app_build_edit', {slug: build.shareSlug, token: token}) }}" method="get">
        <label for="unique-q">Find a unique</label>
        <input type="search" id="unique-q" name="unique" value="{{ uniqueQuery }}" placeholder="name">
        {{ include('build/_search_state.html.twig', {except: 'unique'}) }}
        <button type="submit">Search</button>
    </form>

    {% if uniqueQuery is not empty %}
        <ul>
            {% for item in uniqueResults %}
                <li>
                    <strong>{{ item.name }}</strong> <span>{{ item.detail }}</span>
                    {% if item.ambiguous %}<span>(more than one unique shares this name)</span>{% endif %}
                    <form action="{{ path('app_build_act', {slug: build.shareSlug, token: token}) }}" method="post">
                        <input type="hidden" name="action" value="slot.set">
                        <input type="hidden" name="unique_name" value="{{ item.name }}">
                        <input type="hidden" name="from" value="1">
                        <input type="hidden" name="to" value="100">
                        {{ include('build/_search_state.html.twig') }}
                        <label for="unique-result-{{ loop.index0 }}">Into slot</label>
                        <select id="unique-result-{{ loop.index0 }}" name="position">
                            {% for position in slotPositions %}
                                <option value="{{ position.key }}">{{ position.label }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit">Set</button>
                    </form>
                </li>
            {% else %}
                <li>Nothing matches “{{ uniqueQuery }}”.</li>
            {% endfor %}
        </ul>
    {% endif %}

    <ul>
        {% for position in slotPositions %}
            {% set current = filled[position.key]|default(null) %}
            {% set domId = position.id ~ '-' ~ position.x %}
            <li>
                <form action="{{ path('app_build_act', {slug: build.shareSlug, token: token}) }}" method="post" data-slot="{{ position.key }}">
                    <input type="hidden" name="action" value="slot.set">
                    <input type="hidden" name="position" value="{{ position.key }}">
                    {{ include('build/_search_state.html.twig') }}

                    <label for="slot-name-{{ domId }}">{{ position.label }}</label>
                    <input type="text" id="slot-name-{{ domId }}" name="unique_name" value="{{ current.unique_name|default('') }}" placeholder="a unique's name, or leave empty">

                    <label for="slot-from-{{ domId }}">From</label>
                    <input type="number" id="slot-from-{{ domId }}" name="from" min="0" max="100" value="{{ current.level_interval[0]|default(1) }}">
                    <label for="slot-to-{{ domId }}">to</label>
                    <input type="number" id="slot-to-{{ domId }}" name="to" min="0" max="100" value="{{ current.level_interval[1]|default(100) }}">

                    <label for="slot-text-{{ domId }}">Note</label>
                    <input type="text" id="slot-text-{{ domId }}" name="additional_text" value="{{ current.additional_text|default('') }}">

                    <button type="submit">Save</button>
                </form>

                {% if current %}
                    <form action="{{ path('app_build_act', {slug: build.shareSlug, token: token}) }}" method="post">
                        <input type="hidden" name="action" value="slot.clear">
                        <input type="hidden" name="position" value="{{ position.key }}">
                        {{ include('build/_search_state.html.twig') }}
                        <button type="submit">Clear</button>
                    </form>
                {% endif %}

                {% if 'Amulet1' == position.id %}
                    <div id="build-instilled-search">
                        <h3>Instilled Modifier</h3>
                        <p>Three Distilled Emotions on the amulet grant a passive node's effect without allocating it. Only nodes with a recipe can be instilled.</p>

                        <form action="{{ path('app_build_edit', {slug: build.shareSlug, token: token}) }}" method="get">
                            <label for="instilled-q">Find an instillable node</label>
                            <input type="search" id="instilled-q" name="instilled" value="{{ instilledQuery }}" placeholder="name or id">
                            {{ include('build/_search_state.html.twig', {except: 'instilled'}) }}
                            <button type="submit">Search</button>
                        </form>

                        {% if instilledQuery is not empty %}
                            <ul>
                                {% for node in instilledResults %}
                                    <li>
                                        <strong>{{ node.name }}</strong> <code>{{ node.id }}</code>
                                        {% if node.stats %}<span>{{ node.stats|join(', ') }}</span>{% endif %}
                                        {% if node.recipe %}<span>Recipe: {{ node.recipe|join(', ') }}</span>{% endif %}
                                        <form action="{{ path('app_build_act', {slug: build.shareSlug, token: token}) }}" method="post">
                                            <input type="hidden" name="action" value="instilled.add">
                                            <input type="hidden" name="id" value="{{ node.id }}">
                                            {{ include('build/_search_state.html.twig') }}
                                            <button type="submit">Declare</button>
                                        </form>
                                    </li>
                                {% else %}
                                    <li>Nothing matches “{{ instilledQuery }}”.</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    <div id="build-jewel">
        <h3>Jewel keystone</h3>
        <p>A keystone-radius jewel lets passives near one keystone be allocated without connecting to your tree. Not exported: the .build format has no jewels, so this lives only in this planner.</p>
        <form action="{{ path('app_build_act', {slug: build.shareSlug, token: token}) }}" method="post">
            <input type="hidden" name="action" value="jewel.set">
            {{ include('build/_search_state.html.twig') }}
            <label for="jewel-keystone">Keystone</label>
            <select id="jewel-keystone" name="keystone_id" onchange="this.form.requestSubmit()">
                <option value="">No jewel</option>
                {% for keystone in keystones %}
                    <option value="{{ keystone.id }}" {{ keystone.id == build.jewelKeystone ? 'selected' : '' }}>{{ keystone.name }}</option>
                {% endfor %}
            </select>
            <button type="submit">Save</button>
        </form>
    </div>
</section>
