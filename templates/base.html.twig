<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Build Helper{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {{ importmap('app') }}
    </head>
    <body>
        <header>
            <a href="{{ path('app_home') }}">Build Helper</a>
        </header>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="{{ label }}" role="alert" aria-live="polite">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer>
            <p>This product isn't affiliated with or endorsed by Grinding Gear Games in any way.</p>
        </footer>
    </body>
</html>
